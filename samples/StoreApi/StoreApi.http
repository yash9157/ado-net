@StoreApi_HostAddress = http://localhost:5000
@token = paste-token-from-login-here

POST {{StoreApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "Example123!"
}

###

POST {{StoreApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "Example123!"
}

### Copy accessToken from login into @token above

GET {{StoreApi_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

###

GET {{StoreApi_HostAddress}}/api/products
Authorization: Bearer {{token}}
Accept: application/json

###

GET {{StoreApi_HostAddress}}/api/products?minimumPrice=1000
Authorization: Bearer {{token}}
Accept: application/json

### ADO.NET stored procedure insert with output parameter

POST {{StoreApi_HostAddress}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "USB Hub",
  "price": 999.00
}
